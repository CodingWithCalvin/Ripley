<Application x:Class="Reel.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<!-- Text must inherit the foreground of its owning control. A global TextBlock
     color overrides ComboBox's dark text and hides drive/preset labels. -->
<Style TargetType="Window"><Setter Property="Foreground" Value="#EAF1FA"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#22344B"/><Setter Property="Foreground" Value="#EAF1FA"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#365578"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#EAF1FA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#33475E"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6D5E8"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#D5E4F5"/><Setter Property="BorderBrush" Value="#33475E"/></Style>
</Application.Resources></Application>
