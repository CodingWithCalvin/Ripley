<Window x:Class="Reel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/Reel.ico" Title="Reel · Rip, compress, identify" Width="1300" Height="920" MinWidth="1050" MinHeight="780" Background="#111923" Foreground="#EAF1FA" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#BFD2EA"/><Setter Property="Padding" Value="20,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="B" Background="#16212E" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,3" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#233A55"/><Setter TargetName="B" Property="BorderBrush" Value="#78B8FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111923"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="0,5,0,10"/></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111923"/></Style>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="Background" Value="#16212E"/><Setter Property="Foreground" Value="#EAF1FA"/><Setter Property="RowBackground" Value="#16212E"/><Setter Property="AlternatingRowBackground" Value="#1A293A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="32"/><Setter Property="ColumnHeaderHeight" Value="34"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#22344B"/><Setter Property="Foreground" Value="#AFC5DE"/><Setter Property="Padding" Value="8"/></Style>
</Window.Resources>
<Grid Background="#111923"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0D141E" Padding="22"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Image Source="Assets/Reel.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Reel" FontSize="27" FontWeight="SemiBold"/></StackPanel><TextBlock Text="DISC → SCOUT" Foreground="#78B8FF" Margin="0,10,0,36" FontSize="11"/><TextBlock Text="1   Rip your disc" Margin="0,0,0,18"/><TextBlock Text="2   Compress" Margin="0,0,0,18"/><TextBlock Text="3   Identify in Scout"/><TextBlock Text="Rip the next disc while compression keeps going." TextWrapping="Wrap" Foreground="#92A6BF" Margin="0,32,0,0"/></StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="RAW FILES KEPT" Foreground="#78B8FF" FontSize="11"/><TextBlock Text="Originals stay in your raw-rip folder. Output names never overwrite existing files." TextWrapping="Wrap" Foreground="#92A6BF" Margin="0,10,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="470"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,16"><TextBlock Text="From disc to done." FontSize="27" FontWeight="SemiBold"/><TextBlock Text="All titles over your cutoff. Your HandBrake presets. Ready for Scout." Foreground="#92A6BF" Margin="0,6,0,0"/></StackPanel>
<TabControl Grid.Row="1" Background="#16212E" BorderThickness="0" x:Name="Tabs">
<TabItem Header="Rip a disc"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
<Grid x:Name="RipSetup"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,20,12"><TextBlock Text="01   Insert a disc" FontWeight="SemiBold" FontSize="15"/><DockPanel><Button x:Name="RefreshButton" Content="Refresh" DockPanel.Dock="Right" Click="RefreshDrives" Margin="8,5,0,10"/><ComboBox x:Name="DriveChoice" DisplayMemberPath="Display" SelectionChanged="DriveChanged"/></DockPanel><TextBlock Text="Disc label · detected automatically, editable"/><TextBox x:Name="DiscLabel" TextChanged="NamingChanged" Margin="0,5,0,10"/><WrapPanel><TextBlock Text="Minimum title length (seconds)" VerticalAlignment="Center"/><TextBox x:Name="Minimum" Text="120" Width="65" Margin="12,0,12,0"/><Button Content="View disc details" Click="ShowDiscDetails"/></WrapPanel><TextBlock Text="Titles below the cutoff are skipped. Raw files are always kept." Foreground="#9DB2CD" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="02   Choose the series" FontWeight="SemiBold" FontSize="15"/><DockPanel Margin="0,5,0,7"><Button x:Name="SearchButton" Content="Search TVDB" DockPanel.Dock="Right" Click="SearchSeries" Margin="8,0,0,0"/><TextBox x:Name="SeriesQuery" ToolTip="Search by series name" KeyDown="SeriesQueryKeyDown"/></DockPanel><ListBox x:Name="SeriesResults" DisplayMemberPath="Display" Height="64" SelectionChanged="SeriesChanged"/><TextBlock x:Name="SearchStatus" Foreground="#9DB2CD" TextWrapping="Wrap" Margin="0,4,0,4"/><DockPanel><Button Content="Clear" Click="ClearSeries" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0"/><TextBlock x:Name="SelectedSeriesText" Text="No series selected" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock x:Name="SeriesOverview" Visibility="Collapsed"/><DockPanel Margin="0,5,0,0"><TextBlock Text="Season (optional)" VerticalAlignment="Center"/><TextBox x:Name="Season" TextChanged="SeasonEdited" Width="65" Margin="12,0,0,0" HorizontalAlignment="Left"/><CheckBox x:Name="AutoSeason" Content="Auto from disc label" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Checked="AutoSeasonChanged" Unchecked="AutoSeasonChanged"/></DockPanel><TextBlock x:Name="SeasonHint" Foreground="#9DB2CD" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,0,20,0"><TextBlock Text="03   Raw-rip folders" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Base folder" Margin="0,7,0,0"/><DockPanel Margin="0,4,0,8"><Button Content="Browse…" Click="BrowseRaw" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="RawFolder" TextChanged="NamingChanged"/></DockPanel><TextBlock Text="Folder format"/><TextBox x:Name="RawTemplate" TextChanged="NamingChanged" Margin="0,4,0,6"/><TextBlock x:Name="RawPathPreview" TextWrapping="Wrap" Foreground="#78B8FF" FontSize="12"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="04   Compressed folders" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Base folder" Margin="0,7,0,0"/><DockPanel Margin="0,4,0,8"><Button Content="Browse…" Click="BrowseOutput" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Destination" TextChanged="NamingChanged"/></DockPanel><TextBlock Text="Folder format"/><TextBox x:Name="OutputTemplate" TextChanged="NamingChanged" Margin="0,4,0,6"/><TextBlock x:Name="OutputPathPreview" TextWrapping="Wrap" Foreground="#78B8FF" FontSize="12"/></StackPanel>
</Grid>
<TextBlock Text="{}{series}  {year}  {tvdb_id}  {season}  {season:00}  {volume}  {disc_number}  {disc}  {date} · Use \ for subfolders." Foreground="#9DB2CD" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,4"/>
<TextBlock Text="Existing raw folders get (2), (3), …; compressed folders can collect multiple discs without overwriting files." Foreground="#9DB2CD" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
</StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="16,8,16,12"><WrapPanel><Button x:Name="InspectButton" Content="Inspect disc" Click="InspectDisc"/><Button x:Name="RipButton" Content="Rip + queue compression" Background="#285D91" Click="RipDisc"/><Button x:Name="CancelRipButton" Content="Cancel disc operation" Click="CancelRip" IsEnabled="False"/></WrapPanel>
<TextBlock x:Name="RipStatus" Text="Insert a disc, refresh drives, then choose its series and folder formats." TextWrapping="Wrap" Foreground="#9DB2CD" Margin="0,8,0,8"/><ProgressBar x:Name="RipProgress" Height="5" Maximum="100"/>
</StackPanel></Grid></TabItem>
<TabItem Header="Existing rips"><StackPanel Margin="16"><TextBlock Text="Add previously ripped disc folders. All MKVs are included." Margin="0,0,0,10"/><ListBox x:Name="Folders" Height="130" SelectionMode="Extended"/><WrapPanel Margin="0,12,0,10"><Button Content="+ Add folders" Click="AddFolders"/><Button Content="Remove" Click="RemoveFolders"/><Button x:Name="PreviewButton" Content="Preview names" Click="Preview"/><Button x:Name="StartButton" Content="Queue compression" Click="Start" Background="#285D91"/></WrapPanel><CheckBox x:Name="Recursive" Content="Include subfolders" IsChecked="True"/></StackPanel></TabItem>
<TabItem Header="Preset &amp; tools"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="HandBrake preset file · installed GUI or exported JSON"/><DockPanel Margin="0,5,0,10"><Button Content="Browse…" Click="BrowseJson" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="PresetFile"/></DockPanel><DockPanel><Button Content="Reload" Click="LoadPresets" DockPanel.Dock="Right" Margin="8,5,0,10"/><ComboBox x:Name="PresetChoice" DisplayMemberPath="Display" SelectionChanged="PresetChanged"/></DockPanel><TextBlock x:Name="PresetSummary" TextWrapping="Wrap" Foreground="#9DB2CD"/><TextBlock Text="Hardware decoding" Margin="0,12,0,0"/><ComboBox x:Name="Hardware" SelectedIndex="0"><ComboBoxItem Content="Use installed HandBrake settings"/><ComboBoxItem Content="Software decoding"/><ComboBoxItem Content="NVIDIA NVDEC"/><ComboBoxItem Content="Intel QSV"/></ComboBox><TextBlock Text="Encoder, quality, container, audio, subtitles and filters come from your preset. Hardware decoding depends on source format and driver support." TextWrapping="Wrap" Foreground="#9DB2CD"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="HandBrakeCLI executable"/><DockPanel Margin="0,5,0,10"><Button Content="Browse…" Click="BrowseCli" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Cli"/></DockPanel><TextBlock Text="MakeMKV console executable"/><DockPanel Margin="0,5,0,10"><Button Content="Browse…" Click="BrowseMakeMkv" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="MakeMkv"/></DockPanel><TextBlock Text="HandBrake GUI settings (hardware preferences)"/><DockPanel Margin="0,5,0,10"><Button Content="Browse…" Click="BrowseGuiSettings" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="GuiSettings"/></DockPanel><Button Content="Check preset &amp; hardware" Click="CheckRuntime" HorizontalAlignment="Left"/><TextBlock Text="Scout data folder · saved TVDB credentials" Margin="0,14,0,0"/><DockPanel Margin="0,5,0,0"><Button Content="Browse…" Click="BrowseScout" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="ScoutFolder"/></DockPanel></StackPanel></Grid></ScrollViewer></TabItem>

</TabControl>
<TextBlock Grid.Row="2" x:Name="OutputSummary" Text="Choose base folders and formats on Rip a disc." Foreground="#9DB2CD" TextTrimming="CharacterEllipsis" Margin="0,12,0,10"/>
<Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StopButton" Content="Pause compression" Click="Stop" IsEnabled="False"/><Button Content="Resume / retry" Click="Resume"/></StackPanel><TextBlock x:Name="QueueTitle" Text="Compression queue" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" x:Name="QueueGrid"><DataGrid.Columns><DataGridTextColumn Header="Output filename" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Preset" Binding="{Binding PresetDisplay}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Details" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
<StackPanel Grid.Row="4" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="5" Maximum="100" Foreground="#78B8FF"/><TextBlock x:Name="Status" Text="Choose a preset and output folder, then rip a disc or add existing rips." TextWrapping="Wrap" Foreground="#9DB2CD" Margin="0,10,0,6"/><Expander Header="Activity log" Foreground="#9DB2CD"><TextBox x:Name="Log" Height="95" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/></Expander></StackPanel>
</Grid></Grid></Window>
