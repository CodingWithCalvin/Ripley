<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Ripley.App" ThemeMode="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="CanvasBrush" Color="#111C17" />
      <SolidColorBrush x:Key="PanelBrush" Color="#16271E" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A1B8AA" />
      <SolidColorBrush x:Key="AccentBrush" Color="#78D6A1" />
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="FontSize" Value="14" />
      </Style>
      <Style x:Key="Subtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,8,0,24" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderBrush" Value="#34533E" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,14,0" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="Background" Value="#1B3326" />
        <Setter Property="Foreground" Value="#EAF7EF" />
        <Setter Property="BorderBrush" Value="#42654F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Body" Property="BorderBrush" Value="#BCEFD0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#102C1C" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#20372A" />
        <Setter Property="Foreground" Value="#F0F7F2" />
        <Setter Property="CaretBrush" Value="#78D6A1" />
        <Setter Property="BorderBrush" Value="#385B45" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="#F0F7F2" />
        <Setter Property="RowBackground" Value="#16271E" />
        <Setter Property="AlternatingRowBackground" Value="#1D3125" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="ColumnHeaderHeight" Value="44" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
      </Style>
      <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="#25583A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Geometry x:Key="LibraryIcon">M4,3 L20,3 20,21 4,21 Z M8,3 L8,21 M16,3 L16,21 M4,8 L8,8 M4,16 L8,16 M16,8 L20,8 M16,16 L20,16</Geometry>
      <Geometry x:Key="ActivityIcon">M2,12 L6,12 9,4 14,20 18,10 22,10</Geometry>
      <Geometry x:Key="SettingsIcon">M5,2 L5,7 M5,12 L5,22 M12,2 L12,13 M12,18 L12,22 M19,2 L19,5 M19,10 L19,22 M2,7 L8,7 8,12 2,12 Z M9,13 L15,13 15,18 9,18 Z M16,5 L22,5 22,10 16,10 Z</Geometry>
      <Geometry x:Key="FolderIcon">M2,6 L9,6 11,9 22,9 20,20 2,20 Z M2,6 L2,3 9,3 12,6 20,6 20,9</Geometry>
      <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
      </Style>
      <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#ABBFAF" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="14,13" />
        <Setter Property="Margin" Value="0,0,0,5" />
      </Style>
      <Style x:Key="NavActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Background" Value="#193B27" />
        <Setter Property="Foreground" Value="#A6E8BE" />
        <Setter Property="BorderBrush" Value="#78D6A1" />
      </Style>
      <Style x:Key="TabKeyboardFocus" TargetType="Control">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="3" Stroke="#E3F9EB" StrokeThickness="1" StrokeDashArray="2 2" RadiusX="2" RadiusY="2" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PageTab" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocus}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#ABBFAF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="TabBody" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="TabBody" Property="BorderBrush" Value="#78D6A1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="TabBody" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PageTabActive" TargetType="Button" BasedOn="{StaticResource PageTab}">
        <Setter Property="Background" Value="#224C33" />
        <Setter Property="Foreground" Value="#E3F9EB" />
        <Setter Property="BorderBrush" Value="#78D6A1" />
      </Style>
      <Style TargetType="Window">
        <Setter Property="Foreground" Value="#F0F7F2" />
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,5,0,10" />
        <Setter Property="Foreground" Value="#F0F7F2" />
        <Setter Property="Background" Value="#20372A" />
        <Setter Property="BorderBrush" Value="#385B45" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocus}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid x:Name="ComboBody">
                <ToggleButton Style="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" IsTabStop="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <Path Data="M0,0 L4,4 8,0" Stroke="#A1B8AA" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="10,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" />
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border Background="#20372A" BorderBrush="#42654F" BorderThickness="1" CornerRadius="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBody" Property="Opacity" Value="0.4" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#F0F7F2" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="ItemBody" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#224C33" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#224C33" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemBody" Property="Opacity" Value="0.4" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#D1E6D8" />
      </Style>
      <Style TargetType="ListBox">
        <Setter Property="Background" Value="#20372A" />
        <Setter Property="Foreground" Value="#F0F7F2" />
        <Setter Property="BorderBrush" Value="#385B45" />
      </Style>
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#20372A" />
        <Setter Property="Foreground" Value="#D1E6D8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="#34533E" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>
      <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#294634" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Geometry x:Key="DiscIcon">M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 M5,10 C6,7 7,6 10,5</Geometry>
    </ResourceDictionary>
  </Application.Resources>
</Application>
