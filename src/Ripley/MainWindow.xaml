<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Ripley.MainWindow" WindowStyle="None" ResizeMode="CanResize" Icon="Assets/Ripley.ico" Title="Ripley" Width="1440" Height="920" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" Foreground="#F0F7F2" FontFamily="Segoe UI Variable" FontSize="14" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Background="{StaticResource CanvasBrush}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="—" Click="MinimizeWindow" Width="46" Padding="0" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
        <Button Content="□" Click="ToggleMaximize" Width="46" Padding="0" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" />
        <Button Content="×" Click="CloseWindow" Width="46" Padding="0" ToolTip="Close" AutomationProperties.Name="Close" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
        <Image Source="Assets/Ripley.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="RIPLEY" Foreground="#7F9E8B" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#0E1913" BorderBrush="#2B4835" BorderThickness="0,0,1,0" Padding="14,26,14,20">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <Image Source="Assets/Ripley.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Ripley icon" />
            <Button x:Name="NewRipleyButton" Content="New Ripley" Click="NewRipley" Style="{StaticResource Primary}" Margin="0,0,0,18" ToolTip="Start a new disc session in history. Available after the current disc operation finishes." />
            <Button x:Name="SideCompress" Click="BackToQueue" Style="{StaticResource NavButton}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource LineIcon}" Data="{StaticResource ActivityIcon}" Margin="0,0,10,0" />
                  <TextBlock Text="Compression Queue" />
                </StackPanel>
                <TextBlock x:Name="SidebarQueueSummary" Text="No files queued" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="RIPLEY HISTORY" Foreground="#7F9E8B" FontSize="10" Margin="14,0,0,12" />
            <ListBox x:Name="HistoryList" Grid.Row="1" SelectionChanged="HistorySelected" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="HistoryItem" Background="Transparent" Padding="12,10" BorderBrush="Transparent" BorderThickness="2,0,0,0" Margin="0,0,0,5">
                          <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryItem" Property="Background" Value="#193B27" /></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryItem" Property="Background" Value="#193B27" /><Setter TargetName="HistoryItem" Property="BorderBrush" Value="#78D6A1" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Click="OpenRipHistory" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" HorizontalContentAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <StackPanel Grid.Row="2">
            <Border BorderBrush="#2B4835" BorderThickness="0,1,0,0" Margin="0,14,0,14" />
            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource LineIcon}" Data="{StaticResource SettingsIcon}" Margin="0,0,12,0" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="VersionText" Foreground="#7F9E8B" FontSize="10" Margin="14,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="24,16,24,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock x:Name="PageHeading" Text="New Ripley" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <TextBlock x:Name="PageSubtitle" Text="Insert a disc, choose the series, and set your folders and filenames." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12" />

        </StackPanel>
        <Grid x:Name="RipPage" Grid.Row="1" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="400" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <ScrollViewer x:Name="RipSetupScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
            <StackPanel x:Name="RipSetup">
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel Margin="0">
                  <TextBlock Text="01   Insert a disc" FontWeight="SemiBold" FontSize="17" />
                  <DockPanel>
                    <Button x:Name="RefreshButton" Content="Refresh" DockPanel.Dock="Right" Click="RefreshDrives" Margin="8,5,0,10" ToolTip="Drives refresh automatically on launch and when Windows reports a disc or drive change. Use Refresh to check again." />
                    <ComboBox x:Name="DriveChoice" DisplayMemberPath="Display" SelectionChanged="DriveChanged" />
                  </DockPanel>
                  <TextBlock Text="Disc label · detected automatically, editable" TextWrapping="Wrap" />
                  <TextBox x:Name="DiscLabel" TextChanged="NamingChanged" Margin="0,5,0,10" />
                  <DockPanel>
                    <TextBox x:Name="Minimum" Text="120" Width="65" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBlock Text="Minimum title length (seconds)" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </DockPanel>
                  <Button Content="View disc details" Click="ShowDiscDetails" HorizontalAlignment="Left" Margin="0,8,0,0" />
                  <TextBlock Text="Titles below the cutoff are skipped. Raw files are always kept." Foreground="#A1B8AA" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel Margin="0">
                  <TextBlock Text="02   Choose the series" FontWeight="SemiBold" FontSize="17" />
                  <DockPanel Margin="0,5,0,7">
                    <Button x:Name="SearchButton" Content="Search TVDB" DockPanel.Dock="Right" Click="SearchSeries" Margin="8,0,0,0" />
                    <TextBox x:Name="SeriesQuery" ToolTip="Search by series name" KeyDown="SeriesQueryKeyDown" />
                  </DockPanel>
                  <ListBox x:Name="SeriesResults" DisplayMemberPath="Display" Height="64" SelectionChanged="SeriesChanged">
                    <ListBox.Style>
                      <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
                        <Style.Triggers>
                          <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.Style>
                  </ListBox>
                  <TextBlock x:Name="SearchStatus" Foreground="#A1B8AA" TextWrapping="Wrap" Margin="0,4,0,4" />
                  <DockPanel>
                    <Button Content="Clear" Click="ClearSeries" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" />
                    <TextBlock x:Name="SelectedSeriesText" Text="No series selected" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock x:Name="SeriesOverview" Visibility="Collapsed" />
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Season" FontSize="12" />
                    <TextBlock Text="Volume number" FontSize="12" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Text="Disc number" FontSize="12" Grid.Column="2" TextWrapping="Wrap" />
                    <TextBox x:Name="Season" TextChanged="SeasonEdited" Grid.Row="1" Margin="0,4,8,0" />
                    <TextBox x:Name="Volume" TextChanged="SeasonEdited" Grid.Row="1" Grid.Column="1" Margin="0,4,8,0" />
                    <TextBox x:Name="DiscNumber" TextChanged="SeasonEdited" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" />
                  </Grid>
                  <CheckBox x:Name="AutoSeason" Content="Auto from disc label" IsChecked="True" Margin="0,8,0,0" Checked="AutoSeasonChanged" Unchecked="AutoSeasonChanged" />
                  <TextBlock x:Name="SeasonHint" Foreground="#A1B8AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel Margin="0">
                  <TextBlock Text="03   Raw-rip folders" FontWeight="SemiBold" FontSize="17" />
                  <TextBlock Text="Base folder" Margin="0,7,0,0" />
                  <DockPanel Margin="0,4,0,8">
                    <Button Content="Browse…" Click="BrowseRaw" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox x:Name="RawFolder" TextChanged="NamingChanged" />
                  </DockPanel>
                  <TextBlock Text="Folder format" />
                  <TextBox x:Name="RawTemplate" TextChanged="NamingChanged" Margin="0,4,0,6" />
                  <TextBlock x:Name="RawPathPreview" TextWrapping="Wrap" Foreground="#78D6A1" FontSize="12" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel Margin="0">
                  <TextBlock Text="04   Raw filename prefix" FontWeight="SemiBold" FontSize="17" />
                  <TextBox x:Name="FilenamePrefix" TextChanged="NamingChanged" Margin="0,5,0,5" ToolTip="{}{volume_number}_{disc_number}_" />
                  <TextBlock x:Name="FilenamePreview" Foreground="#78D6A1" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="MakeMKV’s original filename follows the prefix. Raw files and disc metadata are kept. When the rip finishes, you can choose to add just those files to the Compression Queue." Foreground="#A1B8AA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
            <WrapPanel Margin="0,10,0,4">
              <WrapPanel.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#A1B8AA" /><Setter Property="Margin" Value="0,0,8,4" /></Style></WrapPanel.Resources>
              <TextBlock Text="{}{series}" /><TextBlock Text="{}{year}" /><TextBlock Text="{}{tvdb_id}" /><TextBlock Text="{}{season:00}" /><TextBlock Text="{}{volume_number:00}" /><TextBlock Text="{}{disc_number:00}" /><TextBlock Text="{}{disc_label}" /><TextBlock Text="{}{date}" />
            </WrapPanel>
            <TextBlock Text="Use \ for subfolders." Foreground="#A1B8AA" FontSize="12" Margin="0,0,0,4" />
            <TextBlock Text="The folder formats choose the destinations. Files from multiple discs can share those folders; filename collisions get (2), (3), …." Foreground="#A1B8AA" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Ripping queue" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
              <Grid x:Name="RipQueuePanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="RipQueueSummary" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ProgressBar x:Name="RipOverallProgress" Grid.Row="1" Height="5" Maximum="100" Margin="0,0,0,8" />
                <TextBlock x:Name="RipFileActivity" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                <DataGrid x:Name="RipGrid" Grid.Row="3" RowHeight="NaN" MinRowHeight="44" VirtualizingPanel.ScrollUnit="Pixel">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="30" />
                    <DataGridTextColumn Header="Raw filename" Binding="{Binding Name}" Width="*" MinWidth="110">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="6,8" /><Setter Property="ToolTip" Value="{Binding Name}" /></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="6,8" /></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Progress" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid Margin="6,0" MinHeight="40">
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,7" />
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Written" Binding="{Binding Size}" Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="310" Margin="12">
                <StackPanel.Style>
                  <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=RipQueuePanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                </StackPanel.Style>
                <TextBlock Text="Ready for a disc" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Inspect a disc to see its title count. Filenames and progress appear here as MakeMKV writes the raw files." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Filenames appear as MakeMKV creates them. Written files are confirmed as Saved after the complete rip and filename finalization." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="CompressPage" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <Button x:Name="CompressQueueTab" Content="Queues" Click="BackToQueue" Style="{StaticResource PageTab}" />
            <Button x:Name="CompressSourcesTab" Content="Add existing rips" Click="ShowSources" Style="{StaticResource PageTab}" />
            <Button x:Name="CompressOutputTab" Content="Output &amp; presets" Click="ShowCompressionSettings" Style="{StaticResource PageTab}" />
          </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="SourceSetup" Grid.Row="1" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Source folders" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Text="Add disc, season, or series folders. Each file uses its own saved series, season, volume, and disc details. Older rips use explicit markers in source folder names or filenames; the currently inserted disc's values do not apply." TextWrapping="Wrap" Margin="0,0,0,10" />
              <ListBox x:Name="Folders" Height="180" SelectionMode="Extended" />
              <WrapPanel Margin="0,12,0,10">
                <Button Content="+ Add folders" Click="AddFolders" />
                <Button Content="Remove" Click="RemoveFolders" />
              </WrapPanel>
              <CheckBox x:Name="Recursive" Content="Include subfolders" IsChecked="True" />
              <Expander Header="Series for older rips without metadata" Margin="0,16,0,8">
                <StackPanel>
                  <DockPanel Margin="0,8,0,5">
                    <Button x:Name="CompressionSearchButton" Content="Search TVDB" Click="SearchCompressionSeries" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox x:Name="CompressionSeriesQuery" />
                  </DockPanel>
                  <ListBox x:Name="CompressionSeriesResults" DisplayMemberPath="Display" SelectionChanged="CompressionSeriesChanged" Height="64" />
                  <TextBlock x:Name="CompressionSearchStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
              <CheckBox x:Name="ExistingUseSeries" IsChecked="False" Margin="0,16,0,5"><TextBlock Text="Use this series when metadata is missing" TextWrapping="Wrap" MaxWidth="260" /></CheckBox>
              <TextBlock x:Name="ExistingSeriesSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Output settings" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Compressed base folder" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Text, ElementName=Destination}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <TextBlock Text="Folder format · evaluated per file" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Text, ElementName=OutputTemplate}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <TextBlock Text="HandBrake preset" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding SelectedItem.Display, ElementName=PresetChoice, TargetNullValue=Choose a preset on Output &amp; presets}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <Button Content="Change output &amp; presets…" Click="ShowCompressionSettings" HorizontalAlignment="Left" />
                <TextBlock x:Name="ExistingFeedback" Text="Add files to the queue, then choose Start all queues when ready." Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="CompressionSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" VerticalAlignment="Top">
              <StackPanel>
              <TextBlock Text="Compression output" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Text="Compressed output folder" />
              <DockPanel Margin="0,5,0,10">
                <Button Content="Browse…" Click="BrowseOutput" DockPanel.Dock="Right" Margin="8,0,0,0" />
                <TextBox x:Name="Destination" TextChanged="CompressionNamingChanged" />
              </DockPanel>
              <TextBlock Text="Folder format · evaluated per file" />
              <TextBox x:Name="OutputTemplate" TextChanged="CompressionNamingChanged" Margin="0,5,0,10" />
              <TextBlock Text="Filename prefix · external rips only" />
              <TextBox x:Name="CompressionPrefix" Margin="0,5,0,8" />
              <TextBlock Text="These settings apply when adding files to the compression queue. Existing entries keep their settings. Ripley’s own rips already have their prefix. Preview names shows every source and destination." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
                <DockPanel>
                  <Button Content="Reload" Click="LoadPresets" DockPanel.Dock="Right" Margin="8,5,0,10" />
                  <ComboBox x:Name="PresetChoice" DisplayMemberPath="Display" SelectionChanged="PresetChanged" />
                </DockPanel>
                <TextBlock x:Name="PresetSummary" TextWrapping="Wrap" Foreground="#A1B8AA" />
                <TextBlock Text="Hardware decoding" Margin="0,12,0,0" />
                <ComboBox x:Name="Hardware" SelectedIndex="0">
                  <ComboBoxItem Content="Use installed HandBrake settings" />
                  <ComboBoxItem Content="Software decoding" />
                  <ComboBoxItem Content="NVIDIA NVDEC" />
                  <ComboBoxItem Content="Intel QSV" />
                </ComboBox>
                <TextBlock Text="Encoder, quality, container, audio, subtitles and filters come from your preset. Hardware decoding depends on source format and driver support." TextWrapping="Wrap" Foreground="#A1B8AA" />

              </StackPanel>
            </Border>
        </ScrollViewer>
        <Grid x:Name="CompressionQueue" Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="ClearQueueButton" Content="Clear all queues" DockPanel.Dock="Right" Click="ClearQueue" Margin="12,0,0,0" ToolTip="Remove all queue entries; raw and completed files are kept" />
            <TextBlock x:Name="QueueTitle" Text="Compress" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="QueueNotice" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="QueueStateText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="QueueList" SelectionChanged="QueueSelected" Margin="0,0,12,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="10,6" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="QueueItem" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2,0,0,0">
                          <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QueueItem" Property="Background" Value="#224C33" /></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="QueueItem" Property="Background" Value="#224C33" /><Setter TargetName="QueueItem" Property="BorderBrush" Value="#78D6A1" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          <DataGrid Grid.Column="1" x:Name="QueueGrid" RowHeight="NaN" VirtualizingPanel.ScrollUnit="Pixel">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Input and output paths" Width="*" MinWidth="260">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Margin="10,10">
                      <TextBlock Text="Input" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                      <TextBox Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,3,0,8" AutomationProperties.Name="Full input file path" />
                      <TextBlock Text="Output" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                      <TextBox Text="{Binding OutputPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,3,0,0" AutomationProperties.Name="Full output file path" />
                      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Preset" Binding="{Binding PresetDisplay}" Width="120">
                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8,10" /></Style></DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105">
                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8,10" /></Style></DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          </Grid>
        </Grid>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
          <Grid Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,14,0">
              <StackPanel Margin="0">
                <Button Content="Compression output &amp; presets…" Click="ShowCompressionSettings" HorizontalAlignment="Left" Margin="0,0,0,18" />
                <TextBlock Text="HandBrake preset file · installed GUI or exported JSON" />
                <DockPanel Margin="0,5,0,10">
                  <Button Content="Browse…" Click="BrowseJson" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox x:Name="PresetFile" />
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Column="1" Margin="0">
              <StackPanel Margin="0">
                <TextBlock Text="HandBrakeCLI executable" />
                <DockPanel Margin="0,5,0,10">
                  <Button Content="Browse…" Click="BrowseCli" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox x:Name="Cli" />
                </DockPanel>
                <TextBlock Text="MakeMKV console executable" />
                <DockPanel Margin="0,5,0,10">
                  <Button Content="Browse…" Click="BrowseMakeMkv" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox x:Name="MakeMkv" />
                </DockPanel>
                <TextBlock Text="HandBrake GUI settings (hardware preferences)" />
                <DockPanel Margin="0,5,0,10">
                  <Button Content="Browse…" Click="BrowseGuiSettings" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox x:Name="GuiSettings" />
                </DockPanel>
                <Button Content="Check preset &amp; hardware" Click="CheckRuntime" HorizontalAlignment="Left" />
                <TextBlock Text="Scout data folder · saved TVDB credentials" Margin="0,14,0,0" />
                <DockPanel Margin="0,5,0,0">
                  <Button Content="Browse…" Click="BrowseScout" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox x:Name="ScoutFolder" />
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#11251A" BorderBrush="#34533E" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="12,10">
          <StackPanel>
            <StackPanel x:Name="DiscActivity">
              <ProgressBar x:Name="RipProgress" Height="3" Maximum="100" Margin="0,0,0,8" />
              <TextBlock x:Name="RipStatus" Text="Insert a disc. Drives update automatically; choose its series and folder formats." Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,8" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="3" Maximum="100" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="OutputSummary" Text="Choose raw folders on Rip and compressed output on Compress." Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6" />
            <TextBlock x:Name="Status" Text="Rip and Compress work independently. Adding to an idle queue never starts it." Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button x:Name="StopButton" Content="Pause after current file" Click="PauseAfterCurrent" IsEnabled="False" Padding="10,7" />
              <Button x:Name="StartSelectedButton" Content="Start selected queue" Click="StartSelectedQueue" Padding="10,7" />
              <Button x:Name="ResumeButton" Content="Start all queues" Click="Resume" Padding="10,7" />
              <Button x:Name="StopAllButton" Content="Stop all…" Click="StopAll" Padding="10,7" ToolTip="Interrupt the active rip and encode. Raw and completed files are kept; unfinished compressed output is discarded and pending jobs are retained." />
              <Button x:Name="CancelRipButton" Content="Cancel disc operation" Click="CancelRip" Visibility="Collapsed" Padding="10,7" />
              <StackPanel x:Name="RipActions" Orientation="Horizontal">
                <Button x:Name="InspectButton" Content="Inspect disc" Click="InspectDisc" Padding="10,7" />
                <Button x:Name="QueueRipButton" Content="Add to queue" Click="QueueCompletedRip" Padding="10,7" ToolTip="Add only the completed files from the latest disc using your compression settings." />
                <Button x:Name="RipButton" Content="Rip disc" Click="RipDisc" Style="{StaticResource Primary}" Padding="14,8" Margin="0" />
              </StackPanel>
              <StackPanel x:Name="SourceActions" Orientation="Horizontal" Visibility="Collapsed">
                <Button Content="Back to queue" Click="BackToQueue" Padding="10,7" />
                <Button x:Name="PreviewButton" Content="Preview names" Click="Preview" Padding="10,7" />
                <Button x:Name="StartButton" Content="Add to queue" Click="Start" Style="{StaticResource Primary}" Padding="14,8" Margin="0" />
              </StackPanel>
              <Button x:Name="SaveSettingsButton" Content="Save settings" Click="SavePreferences" Style="{StaticResource Primary}" Visibility="Collapsed" Padding="14,8" Margin="0" />
            </WrapPanel>
            <Expander Header="Activity log" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0">
              <TextBox x:Name="Log" Height="100" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
